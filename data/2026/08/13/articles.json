      "title": "Show HN: Programmable timer web app (for gym workouts or stretching sessions)",
      "url": "https://timer.jotaen.net/",
      "source_feed_ids": [
        "hacker-news-frontpage"
      ],
      "published_at": "2026-08-12T18:27:52Z",
